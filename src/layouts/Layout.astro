---
import '../styles/globals.css'
import Nav from '../components/Nav.astro'

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

function getTitleTag(): string {
  const defaultTitle = "Mark McDermott — Software, AI, Attention & Neurodiversity"
  const downstreamPostfix = " — Mark McDermott"
  if (!pageTitle) {
    return defaultTitle
  } else {
    return `${pageTitle}${downstreamPostfix}`
  }
}

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{ getTitleTag() }</title>
	</head>
	<body class="bg-background">
    <div class="rainbow pl-[25px] sm:pl-[4vw]">
      <header class="pt-8 absolute right-10 sm:right-0 w-[30vw]">
        <Nav />
        { Astro.url.pathname ==='/' && <p class="mt-2 max-w-27 sm:max-w-55 text-[0.65rem] text-gray-800">Software, AI, attention and neurodiversity.</p> }
      </header>
      <main>
        <slot />
      </main>
    </div>
	</body>
</html>
