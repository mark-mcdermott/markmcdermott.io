---
import Layout from '@layouts/Layout.astro'
---

<Layout>
  <section class="pt-40 max-w-[70vw] min-h-dvh flex flex-col">
    <h1 class="
      ml-[-0.035em]
      text-[clamp(4rem,18vw,45rem)]
      leading-[0.8]
      tracking-tight
      font-haas
      font-black
      ">About
    </h1>
    <article class="mt-10">
      <p class="mb-4">By day, I’m a Senior QA Engineer at Doximity. By night, I build small software projects and explore how people learn, create, and adapt in an increasingly AI-assisted world.</p>
      <p class="mb-4">I live in Austin, Texas with my wife, daughter, and an ever-growing collection of unfinished ideas.</p>
    </article>
    <div class="socials mt-auto mb-20">
      <h2 class="
        text-2xl
        leading-[0.8]
        font-haas
        font-bold
        ">Elsewhere
      </h2>
      <ul class="mt-2">
        <li><a class="hover:border-b-2" href="https://mark-mcdermott.bsky.social/">Bluesky</a></li>
        <li><a class="hover:border-b-2" href="https://github.com/mark-mcdermott">Github</a></li>
        <li><a class="hover:border-b-2" href="https://www.linkedin.com/in/mark-mcdermott-6a174916/">Linkedin</a></li>
        <li><a class="hover:border-b-2" href="mailto:mark@markmcdermott.io">Email</a></li>
      </ul>
    </div>
  </section>
</Layout>
