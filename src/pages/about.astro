---
import Layout from '@layouts/Layout.astro'
import Socials from '../components/Socials.astro'
---

<Layout pageTitle="About">
  <section class="pt-40 max-w-[70vw] min-h-dvh flex flex-col">
    <h1 class="
      ml-[-0.035em]
      text-[clamp(4rem,18vw,45rem)]
      leading-[0.8]
      tracking-tight
      font-haas
      font-black
      ">About
    </h1>
    <article class="mt-10">
      <p class="mb-4">Senior QA Engineer at Doximity.</p>
      <p class="mb-4">I build software projects and write about learning, attention, and life in an increasingly AI-assisted world.</p>
      <p class="mb-4">Austin, Texas.</p>
    </article>
    <Socials />
  </section>
</Layout>
