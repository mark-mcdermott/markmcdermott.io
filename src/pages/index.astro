---
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

const [latest] = (await getCollection('writing'))
  .sort((a,b) => b.data.date.localeCompare(a.data.date))

const [year, month] = latest. data.date.split('-')
---

<Layout>
  <section class="hero pb-3 flex flex-col justify-end min-h-dvh">
    <h1 class="
      ml-[-0.035em]
      text-[clamp(4rem,18vw,45rem)]
      leading-[0.8]
      tracking-tight
      font-haas
      font-black
      ">Mark McDermott
    </h1>
    <p>
      Programmer.<br />
      Writer.<br />
      Austin, Texas.<br />
    </p>
  </section>
  <article class="article-preview min-h-dvh grid grid-cols-2">
    <h2 class="
      article-title
      mt-6
      ml-[-0.035em]
      leading-[0.92]
      tracking-tight
      text-[clamp(4rem,12vw,45rem)]
      font-haas
      font-black
    ">{latest.data.title}</h2>
    <div class="article-meta pb-24 mr-10 sm:mr-0 justify-self-end self-end">
      <p class="mt-2 w-[30vw] text-[0.9rem]">{latest.data.subtitle}</p>
      <time datetime="2026-03" class="text-[0.7rem] w-[30vw] text-gray-800">03.2026</time>
    </div>
  </article>
</Layout>
